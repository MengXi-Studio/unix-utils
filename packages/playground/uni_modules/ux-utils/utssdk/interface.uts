/**
 * unix-utils 对外 API 声明（interface.uts，官方必需）
 *
 * 「声明和实现」分层（官方 UTS 插件架构）：
 * - 本文件内联声明全部对外类型，供 uts-proxy V1 生成参数编码与
 *   HBuilderX 语法提示（parseInterfaceTypes 仅解析本文件的内联声明）
 * - 对外 API 在各平台 index.uts 内联声明（V1 代理只解析平台入口的
 *   内联 export function / export const，re-export 链不可见，v0.8 实测）
 * - 实现层类型见 utssdk/toast/types（与本文件符号名保持一致，避免双重
 *   维护漂移：修改任一侧必须同步另一侧）
 *
 * v0.8 注意：UTS enum 无法跨 uts-proxy 代理边界（代理模块仅含函数与
 * 原始类型常量），icon / position / 错误码均为字面量联合类型。
 */

/** toast 图标（对齐 uni.showToast 官方 icon 参数并扩展 fail / exception / warning） */
export type ToastIcon = 'success' | 'error' | 'fail' | 'exception' | 'warning' | 'loading' | 'none'

/** toast 位置 */
export type ToastPosition = 'top' | 'center' | 'bottom'

/** toast 失败码（数字字面量联合，对齐官方错误码模式） */
export type ToastErrorCode = 1001 | 2001

/** showToast 成功回调结果（对齐原生） */
export type ToastResult = {
	errMsg: string
}

/** 失败结构：比原生 errCode 更结构化 */
export type ToastFail = {
	/** 错误码 */
	errCode: ToastErrorCode
	/** 固定主题，便于业务过滤 */
	errSubject: string
	/** 错误描述 */
	errMsg: string
	/** 触发问题的参数名（如 'position' / 'image' / 'icon'），无则 null */
	param: string | null
	/** 当前端标识（'app-android' / 'web' / 'mp-weixin' / ...） */
	platform: string
}

/**
 * showToast 选项：对齐 uni.showToast 全参数。
 *
 * 除 title 外均为可选字段（v0.8.1 实测：UTS 插件代理层对必填字段做
 * 非空强转（null as Boolean），业务漏传即 NPE；可选字段代理层才生成
 * null-safe 编码）。实现层（normalize 等）统一对可空值判空兜底。
 */
export type ToastOptions = {
	/** 提示内容 */
	title: string
	/** 图标；不传或 null 表示使用全局默认（success） */
	icon?: ToastIcon | null
	/** 自定义图标本地路径；不传或 null 表示不使用 */
	image?: string | null
	/** 是否显示透明蒙层，防止触摸穿透 */
	mask?: boolean
	/** 提示延迟时间（毫秒），不钳制，原样透传 */
	duration?: number
	/** 位置；不传或 null 表示不启用 position 形态（居中普通 toast） */
	position?: ToastPosition | null
	/** 成功回调 */
	success?: ((res: ToastResult) => void) | null
	/** 失败回调（含降级通知） */
	fail?: ((err: ToastFail) => void) | null
	/** 结束回调（成功或失败都执行） */
	complete?: ((res: any) => void) | null
}

/** 归一化后的内部选项（所有字段均有确定值） */
export type NormalizedOptions = {
	title: string
	icon: ToastIcon
	image: string | null
	mask: boolean
	duration: number
	position: ToastPosition | null
	success: ((res: ToastResult) => void) | null
	fail: ((err: ToastFail) => void) | null
	complete: ((res: any) => void) | null
}

/** 归一化结果：归一化后的选项 + 发生降级的参数名列表 */
export type NormalizeResult = {
	options: NormalizedOptions
	/** 发生降级的参数名列表（如 ['position', 'icon']） */
	degraded: string[]
}

/** 全局默认配置（configureToast 入参；字段为 null 表示沿用库内置默认） */
export type ToastDefaults = {
	/** 默认展示时长（毫秒） */
	duration: number | null
	/** 默认图标 */
	icon: ToastIcon | null
	/** 默认是否显示蒙层 */
	mask: boolean | null
}

/* ============================================================
 * API 函数类型别名（官方模式）
 *
 * 平台入口 index.uts 必须以 `export const apiName: ApiType =
 * function (...) {}` 形态声明 API（对齐官方 uts-api 模板）。
 * 实测（v0.8.1）：插件内所有 .uts 同 Kotlin package，同名 top-level
 * 符号（含悬空调用/悬空转发解析出的孤儿符号）会触发编译器对导出符号
 * 静默重整（showToast → showToast__1）且不报错，业务侧 import 报
 * "xxx is not exported by ?uts-proxy"。实现层函数须加 Impl 后缀保证
 * 符号全局唯一。
 * 本文件的函数类型别名同时是 V1 代理生成参数编码的依据。
 * ============================================================ */

/** showToast 函数类型 */
export type ShowToast = (options: ToastOptions) => void
/** hideToast 函数类型 */
export type HideToast = () => void
/** showToastAsync 函数类型 */
export type ShowToastAsync = (options: ToastOptions) => Promise<void>
/** configureToast 函数类型 */
export type ConfigureToast = (defaults: ToastDefaults) => void
/** showToastSuccess / showToastError / showToastInfo 函数类型 */
export type ShowToastQuick = (title: string) => void
