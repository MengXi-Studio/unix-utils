/**
 * unix-utils 插件跨平台根入口（uni_modules UTS 插件）
 *
 * 官方架构（v0.8）：本文件即无平台目录端（微信 / 鸿蒙）的实现入口。
 * 所有对外 API 以官方模板形态声明：`export const apiName: ApiType =
 * function (...) {}`（ApiType 为 interface.uts 中的函数类型别名）。
 *
 * 两条实测红线（v0.8.1，android V2 代理符号重整问题的真根因）：
 * 1. 插件内所有 .uts 文件在 native 编译时合并到同一 Kotlin package，
 *    任何形式的同名 top-level 符号（实现函数与入口 API 同名、悬空调用
 *    解析出的孤儿符号、指向已改名模块的悬空转发）都会触发编译器对导出
 *    符号静默重整（showToast → showToast__1），且不报任何编译错误，
 *    业务侧 import 报 "xxx is not exported by ?uts-proxy"。故实现层
 *    函数一律加 Impl 后缀，保证与入口 API 全局唯一；
 * 2. 不得用 `export { x } from` 转发链对外暴露 API——uts-proxy V1
 *    代理生成器只解析入口文件的内联声明，转发链对其不可见（iOS 编译报
 *    同上错误）。
 *
 * 常量说明：以下常量为对外契约（代理层仅识别入口内联字面量）。内部
 * 同语义常量已改名 BUILTIN_*（toast/constants/defaults.uts）与
 * ERR_*（toast/enums/toast-error-code.uts），避免同名符号冲突，
 * 修改任一侧值时必须同步另一侧。
 */
import { showToastImpl, hideToastImpl, showToastAsyncImpl } from './toast/show-toast'
import { showToastSuccessImpl, showToastErrorImpl, showToastInfoImpl } from './toast/shortcut'
import { configureToastImpl } from './toast/config'
import type {
	ToastOptions,
	ToastDefaults,
	ToastIcon,
	ToastErrorCode,
	ShowToast,
	HideToast,
	ShowToastAsync,
	ConfigureToast,
	ShowToastQuick
} from './interface.uts'

/* 默认值常量 */
/** 默认展示时长（毫秒） */
export const DEFAULT_DURATION: number = 1500
/** 默认图标 */
export const DEFAULT_ICON: ToastIcon = 'success'
/** 默认是否显示透明蒙层 */
export const DEFAULT_MASK: boolean = false

/* 错误码常量 */
/** 参数非法（如 image 传 gif 于原生通道 App 端） */
export const TOAST_ERR_PARAM_INVALID: ToastErrorCode = 1001
/** 参数当前端不支持且已降级（info 级，不阻断展示） */
export const TOAST_ERR_PLATFORM_UNSUPPORTED: ToastErrorCode = 2001

/* API（官方模式：const + 函数类型别名 + function 表达式） */
/** 展示 toast（回调式，与 uni.showToast 同构，迁移零成本） */
export const showToast: ShowToast = function (options: ToastOptions): void {
	showToastImpl(options)
}

/** 隐藏 toast */
export const hideToast: HideToast = function (): void {
	hideToastImpl()
}

/** Promise 式展示 toast（成功 resolve，失败 reject ToastFail） */
export const showToastAsync: ShowToastAsync = function (options: ToastOptions): Promise<void> {
	return showToastAsyncImpl(options)
}

/** 全局默认配置（字段为 null 表示沿用库内置默认） */
export const configureToast: ConfigureToast = function (defaults: ToastDefaults): void {
	configureToastImpl(defaults)
}

/** 展示成功提示 */
export const showToastSuccess: ShowToastQuick = function (title: string): void {
	showToastSuccessImpl(title)
}

/** 展示错误提示 */
export const showToastError: ShowToastQuick = function (title: string): void {
	showToastErrorImpl(title)
}

/** 展示信息提示（无图标） */
export const showToastInfo: ShowToastQuick = function (title: string): void {
	showToastInfoImpl(title)
}
