/**
 * spike-overlay / App-Android 实现
 *
 * 验证目标：
 * 1. 免注册：UTSAndroid.getUniActivity() + WindowManager.addView 挂应用子窗口（TYPE_APPLICATION_PANEL，无需悬浮窗权限）
 * 2. 触摸穿透：FLAG_NOT_TOUCHABLE，Toast 不消费任何触摸事件
 * 3. 生命周期自管：进入渐显动画、duration 自控计时、退出渐隐后 removeView
 */
import Activity from 'android.app.Activity'
import Context from 'android.content.Context'
import WindowManager from 'android.view.WindowManager'
import TextView from 'android.widget.TextView'
import Gravity from 'android.view.Gravity'
import PixelFormat from 'android.graphics.PixelFormat'
import Color from 'android.graphics.Color'
import GradientDrawable from 'android.graphics.drawable.GradientDrawable'

/** 当前挂载的 Toast 视图（单实例复用） */
let androidOverlay: TextView | null = null
/** 隐藏计时器 id */
let androidHideTimer: number = 0

/** 构建 Toast 视图：深色圆角背景 + 白色文字（Spike 直接用 px，不做 dp 精确适配） */
function buildAndroidToastView(activity: Activity, title: string): TextView {
  const tv = new TextView(activity)
  tv.setText(title)
  tv.setTextColor(Color.WHITE)
  // error17：number(Double) 传 Float 参数需显式 toFloat() 转换
  const textSp = 16.0
  tv.setTextSize(textSp.toFloat())
  tv.setGravity(Gravity.CENTER)
  const bg = new GradientDrawable()
  bg.setColor(Color.parseColor('#D9000000'))
  const radiusPx = 24.0
  bg.setCornerRadius(radiusPx.toFloat())
  tv.setBackground(bg)
  tv.setPadding(48, 28, 48, 28)
  return tv
}

/** Android：直挂窗口展示 Toast（自动在 duration 后隐藏） */
export function showSpikeOverlay(title: string, duration: number): void {
  const act = UTSAndroid.getUniActivity()
  if (act == null) {
    __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:45','[spike-android] getUniActivity() 为 null，无法挂窗')
    return
  }
  const activity = act as Activity
  // 窗口操作必须发生在主线程
  activity.runOnUiThread(() => {
    try {
      const existing = androidOverlay
      if (existing != null) {
        existing.setText(title)
        __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:55','[spike-android] 复用已有窗口视图，更新文案')
      } else {
        const view = buildAndroidToastView(activity, title)
        const wm = activity.getSystemService(Context.WINDOW_SERVICE) as WindowManager
        const params = new WindowManager.LayoutParams()
        // 挂在 Activity 窗口之下的应用子窗口：无需悬浮窗权限（Spike 重点验证项）
        params.type = WindowManager.LayoutParams.TYPE_APPLICATION_PANEL
        // 触摸穿透：完全不吃触摸事件 + 不抢焦点
        params.flags = WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
          | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
          | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
        params.format = PixelFormat.TRANSLUCENT
        params.width = WindowManager.LayoutParams.WRAP_CONTENT
        params.height = WindowManager.LayoutParams.WRAP_CONTENT
        params.gravity = Gravity.CENTER
        // 子窗口必须绑定 Activity 窗口 token，页面就绪后才有效（按钮点击时序满足）
        params.token = activity.getWindow().getDecorView().getWindowToken()
        if (params.token == null) {
          __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:73','[spike-android] windowToken 为 null（页面未就绪），放弃挂载')
          return
        }
        wm.addView(view, params)
        androidOverlay = view
        // 进入动画：透明度渐显
        const alpha0 = 0.0
        const alpha1 = 1.0
        view.setAlpha(alpha0.toFloat())
        view.animate().alpha(alpha1.toFloat()).setDuration(200).start()
        __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:83','[spike-android] addView 成功 type=TYPE_APPLICATION_PANEL')
      }
      // 重置隐藏计时
      if (androidHideTimer != 0) {
        clearTimeout(androidHideTimer)
      }
      androidHideTimer = setTimeout(() => {
        androidHideTimer = 0
        hideSpikeOverlay()
      }, duration)
    } catch (e) {
      __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:94','[spike-android] 挂窗异常: ' + e.message)
    }
  })
}

/** Android：隐藏直挂窗口 Toast */
export function hideSpikeOverlay(): void {
  const view = androidOverlay
  if (view == null) {
    return
  }
  androidOverlay = null
  const act = UTSAndroid.getUniActivity()
  if (act == null) {
    return
  }
  const activity = act as Activity
  activity.runOnUiThread(() => {
    try {
      // 退出动画：透明度渐隐
      const alphaOut = 0.0
      view.animate().alpha(alphaOut.toFloat()).setDuration(200).start()
      // 等退出动画结束后移除，避免动画被截断
      setTimeout(() => {
        try {
          const wm = activity.getSystemService(Context.WINDOW_SERVICE) as WindowManager
          wm.removeView(view)
          __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:121','[spike-android] removeView 成功')
        } catch (e) {
          __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:123','[spike-android] removeView 异常: ' + e.message)
        }
      }, 220)
    } catch (e) {
      __f__('log','at uni_modules/spike-overlay/utssdk/app-android/index.uts:127','[spike-android] 隐藏异常: ' + e.message)
    }
  })
}
