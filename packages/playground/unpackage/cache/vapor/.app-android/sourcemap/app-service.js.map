<template>
	<view class="container">
		<button @click="onModalProbe">showModal 实测</button>
		<button @click="onModalDemo">modal 功能测试</button>
		<button @click="onSuccess">成功</button>
		<button @click="onError">错误</button>
		<button @click="onInfo">信息</button>
		<button @click="onWarning">警告</button>
		<button @click="onTop">顶部</button>
		<button @click="onMask">蒙层</button>
		<button @click="onHide">手动隐藏</button>
		<button @click="onToastAsyncFail">async 降级 reject</button>
	</view>
</template>

<script setup vapor lang="uts">
	import { showToast, showToastSuccess, showToastError, showToastInfo, showToastAsync, hideToast } from '@/uni_modules/ux-utils'

	/**
	 * 跳转 showModal 参数矩阵实测页（M0 前置实测）
	 */
	function onModalProbe(): void {
		uni.navigateTo({
			url: '/pages/modal/probe'
		})
	}

	/**
	 * 跳转 modal 库功能测试页（M3）
	 */
	function onModalDemo(): void {
		uni.navigateTo({
			url: '/pages/modal/demo'
		})
	}

	function onSuccess(): void {
		showToastSuccess('操作成功')
	}

	function onError(): void {
		showToastError('操作失败')
	}

	function onInfo(): void {
		showToastInfo('这是一条消息')
	}

	function onWarning(): void {
		showToast({
			title: '请注意',
			icon: 'warning',
			mask: true,
			duration: 2000
		})
	}

	function onTop(): void {
		showToast({
			title: '顶部提示',
			position: 'top'
		})
	}

	function onMask(): void {
		showToast({
			title: '蒙层提示（触摸被拦截）',
			mask: true
		})
	}

	function onHide(): void {
		showToast({
			title: '5 秒后自动消失，可提前隐藏',
			duration: 5000
		})
		setTimeout(() => {
			hideToast()
		}, 1500)
	}

	/**
	 * toast async 失败契约验证：icon='fail' 全端触发降级（fail 2001 → reject）
	 * 预期：reject 值为 ToastFail 结构 JSON 字符串（errCode=2001 param=icon），屏幕 toast 显示该 JSON
	 */
	function onToastAsyncFail(): void {
		showToastAsync({
			title: 'icon=fail 降级测试',
			icon: 'fail'
		}).then(() => {
			uni.__log__('log','at pages/index/index.uvue:91','[toast-async-fail] resolve（未触发降级）')
		}).catch((err) => {
			const msg = err as string
			uni.__log__('log','at pages/index/index.uvue:94',`[toast-async-fail] reject: ${msg}`)
			showToastError(`reject: ${msg}`)
		})
	}
</script>

<style>
	.container {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-bottom: 24rpx;
	}
</style>
