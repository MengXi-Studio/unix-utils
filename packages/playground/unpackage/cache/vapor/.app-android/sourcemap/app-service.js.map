/**
 * toast 全局默认配置（configureToast）
 *
 * 模块级单例：configureToast 写入，normalize 读取。
 * 字段为 null 时由 normalize 回退到 constants 中的内置默认值。
 */
import type { ToastDefaults } from '../types'
import { DEFAULT_DURATION, DEFAULT_ICON, DEFAULT_MASK } from '../constants'

/** 当前生效的全局默认值 */
let currentDefaults: ToastDefaults = {
	duration: DEFAULT_DURATION,
	icon: DEFAULT_ICON,
	mask: DEFAULT_MASK
}

/**
 * 设置全局默认配置
 * @param defaults 默认值
 */
export function configureToast(defaults: ToastDefaults): void {
	currentDefaults = defaults
}

/**
 * 获取当前全局默认配置
 * @returns 默认值副本
 */
export function getToastDefaults(): ToastDefaults {
	return currentDefaults
}
