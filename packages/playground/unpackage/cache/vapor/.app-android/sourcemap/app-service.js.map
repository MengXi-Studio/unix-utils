/**
 * App 自绘通道（App-Android / App-iOS）—— UTS 直挂系统窗口（v0.7）
 *
 * 通过 unix-window UTS 插件直挂系统窗口（Android WindowManager / iOS UIWindow）：
 * - 免注册：无需 pages.json 注册承载页（v0.7 起 dialogPage 通道退役）
 * - 触摸穿透 / 蒙层拦截 / 动画 / duration 计时由插件自管
 * - 挂窗失败自动降级 uni.showToast 原生通道，并留痕 + fail 回调（降级可见）
 */
import type { NormalizedOptions, ToastFail } from '../../types'
import { ToastIcon, ToastPosition, ToastErrorCode } from '../../enums'
import { TOAST_ERR_SUBJECT } from '../../constants'
import { getPlatform } from '../../utils'
import { showNative } from '../native'
// #ifdef APP-ANDROID || APP-IOS
// 注意：uts-proxy 不转发 type 导出，插件 API 为原始类型参数签名，此处不 import 类型
import { showWindowToast, hideWindowToast } from '@/uni_modules/unix-window'
// #endif

/** icon 枚举转通道字符串（映射与 Web 通道一致） */
function iconToString(icon: ToastIcon): string {
	if (icon == ToastIcon.SUCCESS) return 'success'
	if (icon == ToastIcon.ERROR) return 'error'
	if (icon == ToastIcon.WARNING) return 'warning'
	if (icon == ToastIcon.LOADING) return 'loading'
	return 'none'
}

/** position 枚举转通道字符串（null → bottom，与 Web / dialogPage 通道行为一致） */
function positionToString(position: ToastPosition | null): string {
	if (position == ToastPosition.TOP) return 'top'
	if (position == ToastPosition.CENTER) return 'center'
	return 'bottom'
}

/**
 * 降级通知：通过 fail 回调告知调用方（降级可见原则）
 * @param options 原始选项
 * @param param 触发降级的参数名（无则 null）
 * @param errMsg 描述
 */
function notifyFallback(options: NormalizedOptions, param: string | null, errMsg: string): void {
	if (options.fail == null) return
	const f: ToastFail = {
		errCode: ToastErrorCode.PLATFORM_UNSUPPORTED,
		errSubject: TOAST_ERR_SUBJECT,
		errMsg: errMsg,
		param: param,
		platform: getPlatform()
	}
	options.fail(f)
}

/**
 * 自绘通道展示 toast（UTS 直挂窗口，失败自动降级原生通道）
 * @param options 归一化后的选项
 */
export function showSelfDraw(options: NormalizedOptions): void {
	// #ifdef APP-ANDROID || APP-IOS
	// image 自定义图标：直挂通道暂不渲染本地图片，降级为无图标并回调留痕
	let iconStr = iconToString(options.icon)
	if (options.image != null) {
		iconStr = 'none'
		notifyFallback(options, 'image', '直挂窗口通道暂不渲染 image 自定义图标，已降级')
	}
	showWindowToast(
		options.title,
		iconStr,
		options.mask,
		options.duration,
		positionToString(options.position),
		(errMsg: string) => {
			// 挂窗失败：降级 uni 原生通道（与微信 / 鸿蒙同款），确保提示不丢失
			console.log('[toast] 窗口直挂失败，降级 uni.showToast: ' + errMsg)
			showNative(options)
			notifyFallback(options, null, '窗口直挂失败，已降级原生通道: ' + errMsg)
		}
	)
	// #endif
}

/** 自绘通道隐藏 toast */
export function hideSelfDraw(): void {
	// #ifdef APP-ANDROID || APP-IOS
	hideWindowToast()
	// #endif
}
