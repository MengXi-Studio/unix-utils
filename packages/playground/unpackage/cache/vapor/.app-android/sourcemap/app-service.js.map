<template>
	<view class="container">
		<button @click="onSuccess">成功</button>
		<button @click="onError">错误</button>
		<button @click="onInfo">信息</button>
		<button @click="onWarning">警告</button>
		<button @click="onTop">顶部</button>
		<button @click="onMask">蒙层</button>
		<button @click="onHide">手动隐藏</button>
	</view>
</template>

<script setup vapor lang="uts">
	import { showToast, showToastSuccess, showToastError, showToastInfo, hideToast } from '@/uni_modules/unix-utils'

	function onSuccess(): void {
		showToastSuccess('操作成功')
	}

	function onError(): void {
		showToastError('操作失败')
	}

	function onInfo(): void {
		showToastInfo('这是一条消息')
	}

	function onWarning(): void {
		showToast({
			title: '请注意',
			icon: 'warning',
			mask: true,
			duration: 2000
		})
	}

	function onTop(): void {
		showToast({
			title: '顶部提示',
			position: 'top'
		})
	}

	function onMask(): void {
		showToast({
			title: '蒙层提示（触摸被拦截）',
			mask: true
		})
	}

	function onHide(): void {
		showToast({
			title: '5 秒后自动消失，可提前隐藏',
			duration: 5000
		})
		setTimeout(() => {
			hideToast()
		}, 1500)
	}
</script>

<style>
	.container {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
</style>
