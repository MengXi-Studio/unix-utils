{"code":"/**\n * uni 原生通道（微信 / 鸿蒙等；v0.6 起 Web 走自绘通道不再经过此处）\n *\n * 直接调用 uni.showToast / uni.hideToast，\n * 并将原生 fail 回调转换为结构化 ToastFail。\n */\nimport { NormalizedOptions, ToastFail, ToastResult } from '../types';\nimport { ToastErrorCode } from '../enums';\nimport { TOAST_ERR_SUBJECT } from '../constants';\nimport { getPlatform } from '../utils';\n/**\n * 通过 uni 原生通道展示 toast\n * @param options 归一化后的选项\n */\nexport function showNative(options) {\n    const platform = getPlatform();\n    uni.showToast({\n        title: options.title,\n        icon: options.icon,\n        image: options.image,\n        mask: options.mask,\n        duration: options.duration,\n        position: options.position,\n        success: (res = null) => {\n            if (options.success != null) {\n                const r = new ToastResult({ errMsg: res.errMsg });\n                options.success(r);\n            }\n        },\n        fail: (err = null) => {\n            if (options.fail != null) {\n                const f = new ToastFail({\n                    errCode: ToastErrorCode.PARAM_INVALID,\n                    errSubject: TOAST_ERR_SUBJECT,\n                    errMsg: err.errMsg,\n                    param: null,\n                    platform: platform\n                });\n                options.fail(f);\n            }\n        },\n        complete: (res = null) => {\n            if (options.complete != null)\n                options.complete(res);\n        }\n    });\n}\n/** 通过 uni 原生通道隐藏 toast */\nexport function hideNative() {\n    uni.hideToast();\n}\n//# sourceMappingURL=/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/channels/native.uts.js.map","references":["/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/types/index.uts","/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/enums/index.ut