{"code":"/**\n * 语义化快捷 API：降低调用侧心智\n */\nimport { ToastIcon } from './enums';\nimport { ToastOptions } from './types';\nimport { showToast } from './show-toast';\nimport { getToastDefaults } from './config';\nimport { DEFAULT_DURATION, DEFAULT_MASK } from './constants';\n/**\n * 内部：以指定图标快速展示 toast\n * @param title 提示文本\n * @param icon 图标\n */\nfunction quickShow(title, icon) {\n    const defaults = getToastDefaults();\n    const duration = defaults.duration != null ? defaults.duration : DEFAULT_DURATION;\n    const mask = defaults.mask != null ? defaults.mask : DEFAULT_MASK;\n    const options = new ToastOptions({\n        title: title,\n        icon: icon,\n        image: null,\n        mask: mask,\n        duration: duration,\n        position: null,\n        success: null,\n        fail: null,\n        complete: null\n    });\n    showToast(options);\n}\n/** 展示成功提示 */\nexport function showToastSuccess(title) {\n    quickShow(title, ToastIcon.SUCCESS);\n}\n/** 展示错误提示 */\nexport function showToastError(title) {\n    quickShow(title, ToastIcon.ERROR);\n}\n/** 展示信息提示（无图标） */\nexport function showToastInfo(title) {\n    quickShow(title, ToastIcon.NONE);\n}\n//# sourceMappingURL=/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/shortcut.uts.js.map","references":["/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/enums/index.uts","/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/types/index.uts","/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/show-toast.uts","/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/config/index.uts","/Users/queyupeng/github/MengXi-Studio/unix-utils/packages/playground/node_modules/@meng-xi/unix-utils/src/toast/constants/index.uts"],"ut