<template>
	<scroll-view style="flex:1">
		<view class="container">
			<view class="intro">
				<text class="intro-title">功能说明</text>
				<text class="intro-text">文案长度抹平：按钮文案超 4 字符时小程序端库内截断（App / Web 完整显示）；正文超过屏高 60%（内置阈值）才限高滚动，短内容无滚动条。</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button size="mini" @click="t05LongText">05 超长按钮文案</button>
				<button size="mini" @click="t17ScrollLong">17 超长正文滚动</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志</text>
					<button size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '文案与滚动',
		name: 'modal-text'
	})
	import { showModal } from '@/uni_modules/ux-utils'
	import { describeResult, describeFail } from '@/common/test-utils.uts'

	const logs = reactive<string[]>([])

	function log(tag: string, msg: string): void {
		const line = '[' + tag + '] ' + msg
		logs.unshift(line)
		if (logs.length > 200) {
			logs.splice(200, logs.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.splice(0, logs.length)
	}

	/* ===== 05 超长按钮文案（12 字符）：小程序端截断 4 字符，App / Web 完整显示 ===== */
	function t05LongText(): void {
		showModal({
			title: '超长文案',
			content: '按钮文案均超过 4 个字符，观察截断表现',
			cancelText: '取消按钮超长文案',
			confirmText: '确认按钮超长文案',
			success: (res) => {
				log('05', describeResult(res))
			},
			fail: (err) => {
				log('05', 'fail ' + describeFail(err))
			}
		})
	}

	/* ===== 17 超长正文滚动：超过屏高 60%（内置阈值）才出现滚动区域 ===== */
	function t17ScrollLong(): void {
		let longContent = ''
		for (let i = 0; i < 40; i++) {
			longContent += '这是用于滚动阈值验证的长文本段落，内容重复以撑高弹窗正文区域。'
		}
		showModal({
			title: '超长正文滚动',
			content: longContent,
			success: (res) => {
				log('17', describeResult(res))
			},
			fail: (err) => {
				log('17', 'fail ' + describeFail(err))
			}
		})
	}
</script>
