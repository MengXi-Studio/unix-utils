<template>
	<scroll-view style="flex:1">
		<view class="container">
			<view class="intro">
				<text class="intro-title">功能说明</text>
				<text class="intro-text">confirmColor / cancelColor 全端统一默认色。自绘通道（Web / App）支持 #RGB / #RRGGBB / #RRGGBBAA（alpha 全生效）；微信 / 鸿蒙原生通道剥 alpha 并 fail 2001 留痕；非法值降级默认色 + 结构化 fail。</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button size="mini" @click="t02Color">02 自定义颜色</button>
				<button size="mini" @click="t03Invalid">03 非法颜色</button>
				<button size="mini" @click="t04Alpha">04 8 位色 #RRGGBBAA</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志</text>
					<button size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '颜色体系',
		name: 'modal-color'
	})
	import { showModal } from '@/uni_modules/ux-utils'
	import { describeResult, describeFail } from '@/common/test-utils.uts'

	const logs = reactive<string[]>([])

	function log(tag: string, msg: string): void {
		const line = '[' + tag + '] ' + msg
		logs.unshift(line)
		if (logs.length > 200) {
			logs.splice(200, logs.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.splice(0, logs.length)
	}

	/* ===== 02 自定义按钮颜色（合法 6 位 16 进制） ===== */
	function t02Color(): void {
		showModal({
			title: '自定义颜色',
			content: '确认按钮应为红色，取消按钮应为绿色',
			confirmColor: '#ff0000',
			cancelColor: '#00ff00',
			success: (res) => {
				log('02', describeResult(res))
			},
			fail: (err) => {
				log('02', 'fail ' + describeFail(err))
			}
		})
	}

	/* ===== 03 非法颜色（命名色）→ 降级默认色 + fail 2001 ===== */
	function t03Invalid(): void {
		showModal({
			title: '非法颜色',
			content: 'confirmColor 传入命名色 red，库内应降级为默认色并 fail 2001',
			confirmColor: 'red',
			success: (res) => {
				log('03', describeResult(res))
			},
			fail: (err) => {
				log('03', 'fail ' + describeFail(err))
			}
		})
	}

	/* ===== 04 8 位色值 #RRGGBBAA（自绘通道 alpha 全生效且无 fail） ===== */
	function t04Alpha(): void {
		showModal({
			title: '8 位色值',
			content: '确认按钮为 #88333388，观察透明度是否保留',
			confirmColor: '#88333388',
			success: (res) => {
				log('04', describeResult(res))
			},
			fail: (err) => {
				log('04', 'fail ' + describeFail(err))
			}
		})
	}
</script>
