/**
 * uni 原生通道（微信 / 鸿蒙等；v0.6 起 Web 走自绘通道不再经过此处）
 *
 * 直接调用 uni.showToast / uni.hideToast，
 * 并将原生 fail 回调转换为结构化 ToastFail。
 */
import type { NormalizedOptions, ToastFail, ToastResult } from '../types'
import { ToastErrorCode } from '../enums'
import { TOAST_ERR_SUBJECT } from '../constants'
import { getPlatform } from '../utils'

/**
 * 通过 uni 原生通道展示 toast
 * @param options 归一化后的选项
 */
export function showNative(options: NormalizedOptions): void {
	const platform = getPlatform()
	uni.showToast({
		title: options.title,
		icon: options.icon as any,
		image: options.image,
		mask: options.mask,
		duration: options.duration,
		position: options.position as any,
		success: (res: any) => {
			if (options.success != null) {
				const r: ToastResult = { errMsg: res.errMsg }
				options.success(r)
			}
		},
		fail: (err: any) => {
			if (options.fail != null) {
				const f: ToastFail = {
					errCode: ToastErrorCode.PARAM_INVALID,
					errSubject: TOAST_ERR_SUBJECT,
					errMsg: err.errMsg,
					param: null,
					platform: platform
				}
				options.fail(f)
			}
		},
		complete: (res: any) => {
			if (options.complete != null) options.complete(res)
		}
	})
}

/** 通过 uni 原生通道隐藏 toast */
export function hideNative(): void {
	uni.hideToast()
}
